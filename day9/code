      const count = parseCSVFoods(e.target.result);
      statusEl.className='csv-status ok';
      statusEl.textContent = `Imported ${count} food item(s) from CSV. They're now available in the Food Item dropdown.`;
      rebuildFoodSelect();
      document.getElementById('food-count-tag').textContent = Object.keys(FOODS).length+'-ITEM DATABASE';
    }catch(err){
      statusEl.className='csv-status err';
      statusEl.textContent = 'Could not parse CSV: '+err.message;
    }
  };
  reader.readAsText(file);
}

function parseCSVFoods(text){
  const lines = text.split(/\r?\n/).filter(l=>l.trim().length);
  if(lines.length<2) throw new Error('No data rows found');
  const headers = lines[0].split(',').map(h=>h.trim());
  const required = ['name','type','baseUnit','baseAmt','cal','protein','carbs','fat'];
  required.forEach(r=>{ if(!headers.includes(r)) throw new Error('missing column: '+r); });
  let count=0;
  for(let i=1;i<lines.length;i++){
    const cells = lines[i].split(',').map(c=>c.trim());
    if(cells.length < headers.length) continue;
    const row = {};
    headers.forEach((h,idx)=> row[h]=cells[idx]);
    if(!row.name) continue;
    const entry = { type: (row.type||'veg').toLowerCase(), baseUnit: row.baseUnit||'g', baseAmt: parseFloat(row.baseAmt)||100, custom:true };
    NUTRIENTS.forEach(n=> entry[n] = parseFloat(row[n]) || 0);
    FOODS[row.name] = entry;
    count++;
  }
  return count;
}

