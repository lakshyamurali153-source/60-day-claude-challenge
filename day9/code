  });
}

/* ---------------- TOTALS ---------------- */
function computeTotals(entries){
  const totals = {}; NUTRIENTS.forEach(n=>totals[n]=0);
  (entries||log).forEach(entry=>{
    const vals = computeEntry(entry);
    NUTRIENTS.forEach(n=> totals[n]+=vals[n]);
  });
  return totals;
}

