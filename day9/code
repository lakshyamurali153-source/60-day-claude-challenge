function computeEntry(entry){
  const f = FOODS[entry.food];
  const multiplier = entry.qty / f.baseAmt;
  const out = {};
  NUTRIENTS.forEach(n=> out[n] = (f[n]||0)*multiplier);
  return out;
}

function renderLog(){
  const tbody = document.getElementById('log-tbody');
  tbody.innerHTML='';
  document.getElementById('log-empty').style.display = log.length ? 'none':'block';
  log.forEach((entry, idx)=>{
    const f = FOODS[entry.food];
    const vals = computeEntry(entry);
    const tr = document.createElement('tr');
    const pillClass = f.custom ? 'custom' : (f.type==='veg'?'veg':(f.type==='egg'?'egg':'nonveg'));
    const pillLabel = f.custom ? 'Custom' : (f.type==='veg'?'Veg':(f.type==='egg'?'Egg':'Non-Veg'));
    tr.innerHTML = `
      <td class="food-row-name">${entry.food}</td>
      <td><span class="pill ${pillClass}">${pillLabel}</span></td>
      <td><input type="number" min="0.25" step="0.25" value="${entry.qty}" data-idx="${idx}" class="qty-edit" style="width:70px;"></td>
      <td>${entry.unit}</td>
      <td>${vals.cal.toFixed(0)} kcal</td>
      <td>${vals.protein.toFixed(1)} g</td>
      <td><button class="btn danger" data-idx="${idx}">Remove</button></td>
    `;
    tbody.appendChild(tr);
  });
  tbody.querySelectorAll('button.danger').forEach(b=>{
    b.addEventListener('click', ()=>{ log.splice(parseInt(b.dataset.idx),1); renderLog(); });
  });
  tbody.querySelectorAll('.qty-edit').forEach(inp=>{
