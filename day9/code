/* ---------------- RISK ANALYSIS ---------------- */
function renderRisk(){
  const riskList = document.getElementById('risk-list');
  if(!profile || !targets || log.length===0){
    riskList.innerHTML = `<div class="empty-state">Set up your profile and log some food to see risk flags.</div>`;
    return;
  }
  const totals = computeTotals();
  const pct = (c,t)=> t>0 ? (c/t)*100 : 0;

  const risks = [];

  // Anemia risk pattern: low iron + low B12 + low folate
  const ironPct = pct(totals.iron,targets.iron), b12Pct = pct(totals.b12,targets.b12), folatePct = pct(totals.folate,targets.folate);
  const anemiaFlags = [ironPct<60, b12Pct<60, folatePct<60].filter(Boolean).length;
  risks.push({
    name:'Anemia-pattern risk',
    level: anemiaFlags>=2 ? 'high' : (anemiaFlags===1 ? 'moderate':'low'),
    desc: anemiaFlags>=2
      ? `Iron (${ironPct.toFixed(0)}%), B12 (${b12Pct.toFixed(0)}%) and folate (${folatePct.toFixed(0)}%) are jointly low — this combination is a common dietary pattern behind anemia. Consider more legumes, leafy greens, and dairy/eggs paired with Vitamin C, and get a CBC/ferritin test if you feel fatigued.`
      : anemiaFlags===1
      ? `One of iron, B12 or folate is trending low (Fe ${ironPct.toFixed(0)}%, B12 ${b12Pct.toFixed(0)}%, folate ${folatePct.toFixed(0)}%). Worth watching over a few more days of logging.`
      : `Iron, B12 and folate intake all look reasonably on track today.`
  });

  // Bone health risk: low calcium + low vitD
  const calciumPct = pct(totals.calcium,targets.calcium), vitDPct = pct(totals.vitD,targets.vitD);
  const boneFlags = [calciumPct<60, vitDPct<60].filter(Boolean).length;
  risks.push({
    name:'Bone health risk',
    level: boneFlags===2 ? 'high' : (boneFlags===1 ? 'moderate':'low'),
    desc: boneFlags===2
      ? `Both Calcium (${calciumPct.toFixed(0)}%) and Vitamin D (${vitDPct.toFixed(0)}%) are low — Vitamin D is needed to absorb calcium, so this combo compounds bone-density risk over time. Add dairy or Tofu, and get some sunlight exposure or a D3 supplement after medical advice.`
      : boneFlags===1
      ? `Either calcium or Vitamin D is under target (Ca ${calciumPct.toFixed(0)}%, D ${vitDPct.toFixed(0)}%). Keep an eye on it.`
      : `Calcium and Vitamin D intake are both reasonably covered.`
  });

  // Energy deficit / surplus risk
  const calPct = pct(totals.cal,targets.cal);
  risks.push({
    name:'Energy balance risk',
    level: (calPct<70 || calPct>140) ? 'high' : ((calPct<85 || calPct>120) ? 'moderate':'low'),
    desc: calPct<70
      ? `You're logging well under your calorie target (${calPct.toFixed(0)}%). Sustained large deficits can affect energy, concentration and muscle mass — review portion sizes.`
      : calPct>140
      ? `You're logging well above target (${calPct.toFixed(0)}%). Sustained surplus contributes to weight gain over time — review portion sizes and snacking frequency.`
      : `Calorie intake is within a reasonable range of your target (${calPct.toFixed(0)}%).`
  });

  // Sodium / hypertension-pattern risk
  const sodiumPct = pct(totals.sodium,targets.sodium);
  risks.push({
    name:'Excess sodium risk',
    level: sodiumPct>150 ? 'high' : (sodiumPct>100 ? 'moderate':'low'),
    desc: sodiumPct>150
      ? `Sodium is at ${sodiumPct.toFixed(0)}% of the recommended daily limit — frequent intake at this level over time is associated with elevated blood pressure risk. Cut back on salty snacks, pickles, and packaged/fried items.`
      : sodiumPct>100
      ? `Sodium is slightly over the daily limit (${sodiumPct.toFixed(0)}%) — keep an eye on processed and fried food.`
      : `Sodium intake looks within the recommended range.`
  });

  // Protein inadequacy risk
  const proteinPct = pct(totals.protein,targets.protein);
  risks.push({
    name:'Protein inadequacy risk',
    level: proteinPct<60 ? 'high' : (proteinPct<85 ? 'moderate':'low'),
    desc: proteinPct<60
      ? `Protein is well below target (${proteinPct.toFixed(0)}%). Persistently low protein can affect muscle recovery and immune function — prioritize a protein source at every meal.`
      : proteinPct<85
      ? `Protein is a bit under target (${proteinPct.toFixed(0)}%). A small addition per meal would close the gap.`
      : `Protein intake is on track.`
  });

  const order = {high:0, moderate:1, low:2};
  risks.sort((a,b)=> order[a.level]-order[b.level]);

  riskList.innerHTML = risks.map(r=>`
    <div class="risk-card risk-${r.level}">
      <div class="risk-head">
        <span class="risk-name">${r.name}</span>
        <span class="risk-badge risk-${r.level}">${r.level}</span>
      </div>
      <div class="risk-desc">${r.desc}</div>
    </div>
  `).join('');
}

/* init */
renderLog();
</script>
</body>
</html>
