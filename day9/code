<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NutriScope — Nutrition Intelligence</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<style>
:root{
  --bg:#0b0f14;
  --bg-elev:#111820;
  --card:#141c26;
  --card-hover:#182230;
  --border:#232e3c;
  --text:#e7edf3;
  --text-dim:#8fa1b3;
  --text-faint:#5b6b7c;
  --accent:#4fd1c5;
  --accent2:#8b7cf6;
  --warn:#f5a962;
  --danger:#f0645f;
  --good:#5fd68c;
  --font-display:'Space Grotesk', 'Segoe UI', sans-serif;
  --font-body:'Inter', 'Segoe UI', sans-serif;
  --font-mono:'IBM Plex Mono', monospace;
  --radius:14px;
}
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap');
*{box-sizing:border-box;margin:0;padding:0;}
body{
  background:
    radial-gradient(ellipse 900px 500px at 15% -5%, rgba(79,209,197,0.10), transparent),
    radial-gradient(ellipse 700px 400px at 100% 10%, rgba(139,124,246,0.08), transparent),
    var(--bg);
  color:var(--text);
  font-family:var(--font-body);
  min-height:100vh;
  padding-bottom:60px;
}
::selection{background:rgba(79,209,197,0.3);}
.wrap{max-width:1200px;margin:0 auto;padding:0 22px;}

/* Header */
header.topbar{
  border-bottom:1px solid var(--border);
  background:rgba(11,15,20,0.85);
  backdrop-filter:blur(10px);
  position:sticky;top:0;z-index:50;
}
.topbar-inner{display:flex;align-items:center;justify-content:space-between;padding:16px 22px;max-width:1200px;margin:0 auto;flex-wrap:wrap;gap:10px;}
.brand{display:flex;align-items:center;gap:10px;font-family:var(--font-display);font-weight:700;font-size:1.25rem;letter-spacing:-0.02em;}
.brand .mark{
  width:30px;height:30px;border-radius:8px;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  display:flex;align-items:center;justify-content:center;
  font-size:14px;color:#0b0f14;font-weight:800;
}
.brand .sub{color:var(--text-faint);font-size:.72rem;font-family:var(--font-mono);font-weight:400;letter-spacing:0.06em;margin-left:6px;}
nav.tabs{display:flex;gap:4px;flex-wrap:wrap;}
.tab-btn{
  background:none;border:1px solid transparent;color:var(--text-dim);
  padding:8px 13px;border-radius:9px;font-family:var(--font-body);font-weight:600;font-size:.82rem;
  cursor:pointer;transition:.15s;white-space:nowrap;
}
.tab-btn:hover{color:var(--text);background:var(--card-hover);}
.tab-btn.active{background:var(--card);color:var(--accent);border-color:var(--border);}

/* Disclaimer banner */
.disclaimer-banner{
  background:linear-gradient(90deg, rgba(139,124,246,0.10), rgba(79,209,197,0.06));
  border-bottom:1px solid var(--border);
  padding:9px 22px;text-align:center;font-size:.76rem;color:var(--text-dim);
  font-family:var(--font-mono);
}
.disclaimer-banner b{color:var(--accent2);}
.disclaimer-banner button{background:none;border:none;color:var(--text-faint);cursor:pointer;margin-left:10px;text-decoration:underline;font-size:.76rem;font-family:var(--font-mono);}

main{max-width:1200px;margin:0 auto;padding:26px 22px 0;}
.view{display:none;animation:fade .35s ease;}
.view.active{display:block;}
@keyframes fade{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}

h2.section-title{
  font-family:var(--font-display);font-size:1.05rem;font-weight:600;
  margin:26px 0 14px;color:var(--text);
  display:flex;align-items:center;gap:8px;flex-wrap:wrap;
}
h2.section-title .tag{font-family:var(--font-mono);font-size:.65rem;color:var(--text-faint);font-weight:400;letter-spacing:.05em;border:1px solid var(--border);padding:2px 7px;border-radius:20px;}

.card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:var(--radius);
  padding:20px;
}
.grid{display:grid;gap:16px;}
.grid-2{grid-template-columns:1fr 1fr;}
.grid-3{grid-template-columns:repeat(3,1fr);}
.grid-4{grid-template-columns:repeat(4,1fr);}

label{display:block;font-size:.72rem;color:var(--text-dim);margin-bottom:6px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;}
input,select{
  width:100%;background:var(--bg-elev);border:1px solid var(--border);color:var(--text);
  padding:10px 12px;border-radius:9px;font-family:var(--font-body);font-size:.9rem;
  outline:none;transition:.15s;
}
input:focus,select:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(79,209,197,0.12);}
.field{margin-bottom:14px;}

.btn{
  background:linear-gradient(135deg,var(--accent),#3bb8ac);
  color:#08141a;border:none;padding:11px 18px;border-radius:9px;
  font-weight:700;font-size:.85rem;cursor:pointer;transition:.15s;font-family:var(--font-body);
}
.btn:hover{filter:brightness(1.08);transform:translateY(-1px);}
.btn.secondary{background:var(--card-hover);color:var(--text);border:1px solid var(--border);}
.btn.ghost{background:none;border:1px solid var(--border);color:var(--text-dim);padding:7px 12px;font-size:.78rem;}
.btn.danger{background:rgba(240,100,95,0.12);color:var(--danger);border:1px solid rgba(240,100,95,0.3);padding:6px 10px;font-size:.75rem;}
.btn.full{width:100%;}
.btn.small{padding:7px 12px;font-size:.76rem;}

/* Stat cards */
.stat-card{
  background:var(--card);border:1px solid var(--border);border-radius:var(--radius);
  padding:18px;position:relative;overflow:hidden;
}
.stat-card .label{font-size:.68rem;color:var(--text-faint);text-transform:uppercase;letter-spacing:.06em;font-weight:600;margin-bottom:8px;}
.stat-card .value{font-family:var(--font-display);font-size:1.7rem;font-weight:700;}
.stat-card .value small{font-size:.9rem;color:var(--text-dim);font-weight:500;}
.stat-card .bar-track{height:6px;background:var(--bg-elev);border-radius:6px;margin-top:12px;overflow:hidden;}
.stat-card .bar-fill{height:100%;border-radius:6px;background:linear-gradient(90deg,var(--accent),var(--accent2));transition:width .5s ease;}

/* Food log table */
table{width:100%;border-collapse:collapse;}
th{text-align:left;font-size:.68rem;color:var(--text-faint);text-transform:uppercase;letter-spacing:.05em;padding:8px 10px;border-bottom:1px solid var(--border);font-weight:600;}
td{padding:9px 10px;border-bottom:1px solid var(--border);font-size:.85rem;}
tr:last-child td{border-bottom:none;}
td input,td select{padding:6px 8px;font-size:.82rem;}
.food-row-name{font-weight:600;}
.pill{display:inline-block;padding:2px 9px;border-radius:20px;font-size:.68rem;font-weight:600;font-family:var(--font-mono);}
.pill.veg{background:rgba(95,214,140,0.14);color:var(--good);}
.pill.egg{background:rgba(245,169,98,0.14);color:var(--warn);}
.pill.nonveg{background:rgba(240,100,95,0.14);color:var(--danger);}
.pill.custom{background:rgba(139,124,246,0.14);color:var(--accent2);}

.log-add-row{display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:10px;align-items:end;margin-bottom:18px;}

/* CSV upload zone */
.upload-zone{
  border:1.5px dashed var(--border);border-radius:12px;padding:22px;text-align:center;
  background:var(--bg-elev);cursor:pointer;transition:.15s;margin-bottom:10px;
}
.upload-zone:hover{border-color:var(--accent);background:rgba(79,209,197,0.04);}
.upload-zone .icon{font-size:1.6rem;margin-bottom:6px;}
.upload-zone .hint{font-size:.75rem;color:var(--text-faint);margin-top:4px;}
#csv-file-input{display:none;}
.csv-status{font-size:.8rem;margin-top:8px;font-family:var(--font-mono);}
.csv-status.ok{color:var(--good);}
.csv-status.err{color:var(--danger);}

/* Dashboard */
.deficiency-item,.excess-item{
  display:flex;justify-content:space-between;align-items:center;
  padding:10px 12px;border-radius:9px;background:var(--bg-elev);margin-bottom:8px;font-size:.85rem;
}
.deficiency-item .amt{color:var(--danger);font-family:var(--font-mono);font-weight:600;font-size:.78rem;}
.excess-item .amt{color:var(--warn);font-family:var(--font-mono);font-weight:600;font-size:.78rem;}

.nutrient-table td:nth-child(2),.nutrient-table td:nth-child(3),.nutrient-table td:nth-child(4){font-family:var(--font-mono);font-size:.8rem;color:var(--text-dim);}
.status-dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;}
.status-low{background:var(--danger);}
.status-ok{background:var(--good);}
.status-high{background:var(--warn);}

.rec-card{
  border-left:3px solid var(--accent);background:var(--bg-elev);border-radius:0 9px 9px 0;
  padding:12px 14px;margin-bottom:10px;font-size:.85rem;
}
.rec-card .rec-type{font-size:.65rem;color:var(--accent);text-transform:uppercase;letter-spacing:.05em;font-weight:700;margin-bottom:4px;font-family:var(--font-mono);}
.rec-card.swap{border-left-color:var(--accent2);}
.rec-card.swap .rec-type{color:var(--accent2);}
.rec-card.portion{border-left-color:var(--warn);}
.rec-card.portion .rec-type{color:var(--warn);}
.rec-card.timing{border-left-color:#5fd68c;}
.rec-card.timing .rec-type{color:#5fd68c;}
.rec-card.pairing{border-left-color:#f0645f;}
.rec-card.pairing .rec-type{color:#f0645f;}

/* Risk analysis */
.risk-card{
  background:var(--bg-elev);border-radius:11px;padding:16px;margin-bottom:12px;
  border-left:3px solid var(--border);
}
.risk-card.risk-low{border-left-color:var(--good);}
.risk-card.risk-moderate{border-left-color:var(--warn);}
.risk-card.risk-high{border-left-color:var(--danger);}
.risk-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;}
.risk-name{font-weight:700;font-family:var(--font-display);font-size:.95rem;}
.risk-badge{font-family:var(--font-mono);font-size:.68rem;padding:3px 10px;border-radius:20px;text-transform:uppercase;letter-spacing:.04em;font-weight:700;}
.risk-badge.risk-low{background:rgba(95,214,140,0.14);color:var(--good);}
.risk-badge.risk-moderate{background:rgba(245,169,98,0.14);color:var(--warn);}
.risk-badge.risk-high{background:rgba(240,100,95,0.14);color:var(--danger);}
.risk-desc{font-size:.82rem;color:var(--text-dim);line-height:1.5;}

/* Meal planner */
.day-tabs{display:flex;gap:8px;margin-bottom:16px;}
.day-tab-btn{background:var(--card);border:1px solid var(--border);color:var(--text-dim);padding:9px 20px;border-radius:9px;cursor:pointer;font-weight:600;font-size:.85rem;}
.day-tab-btn.active{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#08141a;border-color:transparent;}
.meal-slot{margin-bottom:18px;}
.meal-slot-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;}
.meal-slot-head h3{font-family:var(--font-display);font-size:.9rem;font-weight:600;color:var(--accent);}
.meal-items{min-height:36px;}
.meal-item-row{display:flex;justify-content:space-between;align-items:center;background:var(--bg-elev);border-radius:8px;padding:8px 12px;margin-bottom:6px;font-size:.83rem;}
.meal-item-row .mi-cal{color:var(--text-faint);font-family:var(--font-mono);font-size:.74rem;margin-right:10px;}
.meal-add-inline{display:grid;grid-template-columns:2fr 1fr auto;gap:8px;}
.day-summary-row{display:flex;gap:10px;margin-top:6px;flex-wrap:wrap;}
.day-summary-row .chip{background:var(--bg-elev);border:1px solid var(--border);border-radius:20px;padding:5px 12px;font-size:.74rem;font-family:var(--font-mono);color:var(--text-dim);}

.empty-state{text-align:center;padding:40px 20px;color:var(--text-faint);font-size:.88rem;}
.chart-wrap{position:relative;height:230px;}
.chart-wrap.small{height:190px;}
.chart-wrap.tall{height:320px;}

/* Sources */
.source-item{padding:12px 0;border-bottom:1px solid var(--border);font-size:.85rem;}
.source-item:last-child{border-bottom:none;}
.source-item .src-name{font-weight:600;color:var(--text);}
.source-item .src-note{color:var(--text-faint);font-size:.78rem;margin-top:2px;}

footer{text-align:center;color:var(--text-faint);font-size:.72rem;padding:40px 0 10px;font-family:var(--font-mono);}

@media(max-width:820px){
  .grid-2,.grid-3,.grid-4{grid-template-columns:1fr;}
  .log-add-row{grid-template-columns:1fr;}
  .meal-add-inline{grid-template-columns:1fr;}
  .topbar-inner{flex-direction:column;gap:10px;align-items:flex-start;}
  nav.tabs{width:100%;overflow-x:auto;}
}
</style>
</head>
<body>

<header class="topbar">
  <div class="topbar-inner">
    <div class="brand"><span class="mark">N</span>NutriScope <span class="sub">v2.0 · local-only</span></div>
    <nav class="tabs">
      <button class="tab-btn active" data-view="profile">Profile</button>
      <button class="tab-btn" data-view="log">Food Log</button>
      <button class="tab-btn" data-view="planner">Meal Planner</button>
      <button class="tab-btn" data-view="dashboard">Dashboard</button>
      <button class="tab-btn" data-view="recs">Recommendations</button>
      <button class="tab-btn" data-view="risk">Risk Analysis</button>
      <button class="tab-btn" data-view="sources">Sources</button>
    </nav>
  </div>
</header>

<div class="disclaimer-banner" id="disclaimer-banner">
  <b>Educational tool only</b> — not medical advice. NutriScope gives general nutrition estimates, not clinical diagnoses. Consult a registered dietitian or doctor for personal health decisions.
  <button id="disclaimer-more">read more</button>
</div>

<main>

  <!-- PROFILE VIEW -->
  <section class="view active" id="view-profile">
    <h2 class="section-title">Your Profile <span class="tag">STEP 1</span></h2>
    <div class="card">
      <div class="grid grid-3">
        <div class="field"><label>Age</label><input type="number" id="pf-age" placeholder="e.g. 21" min="10" max="100"></div>
        <div class="field"><label>Gender</label>
          <select id="pf-gender"><option value="male">Male</option><option value="female">Female</option><option value="other">Other</option></select>
        </div>
        <div class="field"><label>Activity Level</label>
          <select id="pf-activity">
            <option value="1.2">Sedentary (little/no exercise)</option>
            <option value="1.375">Light (1-3 days/week)</option>
            <option value="1.55" selected>Moderate (3-5 days/week)</option>
            <option value="1.725">Active (6-7 days/week)</option>
            <option value="1.9">Very Active (athlete)</option>
          </select>
        </div>
        <div class="field"><label>Height (cm)</label><input type="number" id="pf-height" placeholder="e.g. 170"></div>
        <div class="field"><label>Weight (kg)</label><input type="number" id="pf-weight" placeholder="e.g. 60"></div>
        <div class="field"><label>Dietary Preference</label>
          <select id="pf-diet">
            <option value="veg">Vegetarian</option>
            <option value="egg">Eggetarian</option>
            <option value="nonveg">Non-Vegetarian</option>
          </select>
        </div>
      </div>
      <button class="btn" id="pf-save">Save Profile &amp; Calculate Targets</button>
      <span id="pf-status" style="margin-left:14px;color:var(--good);font-size:.82rem;"></span>
    </div>

    <h2 class="section-title">Your Daily Targets <span class="tag">AUTO-CALCULATED</span></h2>
    <div class="grid grid-4" id="target-cards">
      <div class="stat-card"><div class="label">Calories</div><div class="value" id="t-cal">—</div></div>
      <div class="stat-card"><div class="label">Protein</div><div class="value" id="t-protein">—</div></div>
      <div class="stat-card"><div class="label">Carbs</div><div class="value" id="t-carbs">—</div></div>
      <div class="stat-card"><div class="label">Fat</div><div class="value" id="t-fat">—</div></div>
    </div>
  </section>

  <!-- FOOD LOG VIEW -->
  <section class="view" id="view-log">
    <h2 class="section-title">Import Foods from CSV <span class="tag">OPTIONAL</span></h2>
    <div class="card">
      <div class="upload-zone" id="upload-zone">
        <div class="icon">⇪</div>
        <div>Click to upload a CSV, or drag one here</div>
        <div class="hint">Columns: name,type,baseUnit,baseAmt,cal,protein,carbs,fat,fiber,iron,calcium,vitC,vitD,b12,magnesium,zinc,potassium,sodium,vitA,folate — type is veg/egg/nonveg</div>
      </div>
      <input type="file" id="csv-file-input" accept=".csv">
      <div class="csv-status" id="csv-status"></div>
    </div>

    <h2 class="section-title">Log a Food <span class="tag" id="food-count-tag">60-ITEM DATABASE</span></h2>
    <div class="card">
      <div class="log-add-row">
        <div class="field" style="margin-bottom:0;"><label>Food Item</label>
          <select id="log-food"></select>
        </div>
        <div class="field" style="margin-bottom:0;"><label>Quantity</label><input type="number" id="log-qty" value="1" min="0.25" step="0.25"></div>
        <div class="field" style="margin-bottom:0;"><label>Unit</label>
          <select id="log-unit"></select>
        </div>
        <button class="btn" id="log-add">Add Food</button>
      </div>
    </div>

    <h2 class="section-title">Today's Log</h2>
    <div class="card">
      <table id="log-table">
        <thead><tr><th>Food</th><th>Type</th><th>Qty</th><th>Unit</th><th>Calories</th><th>Protein</th><th></th></tr></thead>
        <tbody id="log-tbody"></tbody>
      </table>
      <div class="empty-state" id="log-empty">No food logged yet. Add your first item above.</div>
    </div>
  </section>

  <!-- MEAL PLANNER VIEW -->
  <section class="view" id="view-planner">
    <h2 class="section-title">2-Day Meal Planner <span class="tag">PLAN AHEAD</span></h2>
    <div class="day-tabs">
      <button class="day-tab-btn active" data-day="1">Day 1</button>
      <button class="day-tab-btn" data-day="2">Day 2</button>
    </div>
    <div id="planner-body"></div>
  </section>

  <!-- DASHBOARD VIEW -->
  <section class="view" id="view-dashboard">
    <h2 class="section-title">Energy Progress</h2>
    <div class="grid grid-3">
      <div class="stat-card" style="grid-column:span 1;">
        <div class="label">Consumed / Target</div>
        <div class="value" id="d-energy">0 <small>/ 0 kcal</small></div>
        <div class="bar-track"><div class="bar-fill" id="d-energy-bar" style="width:0%;"></div></div>
      </div>
      <div class="stat-card">
        <div class="label">Protein</div>
        <div class="value" id="d-protein">0 <small>/ 0 g</small></div>
        <div class="bar-track"><div class="bar-fill" id="d-protein-bar" style="width:0%;"></div></div>
      </div>
      <div class="stat-card">
        <div class="label">Fiber</div>
        <div class="value" id="d-fiber">0 <small>/ 0 g</small></div>
        <div class="bar-track"><div class="bar-fill" id="d-fiber-bar" style="width:0%;"></div></div>
      </div>
    </div>

    <div class="grid grid-2" style="margin-top:16px;">
      <div class="card">
        <h2 class="section-title" style="margin-top:0;">Macro Split</h2>
        <div class="chart-wrap"><canvas id="macroChart"></canvas></div>
      </div>
      <div class="card">
        <h2 class="section-title" style="margin-top:0;">Micronutrient Radar</h2>
        <div class="chart-wrap tall"><canvas id="radarChart"></canvas></div>
      </div>
    </div>

    <div class="card" style="margin-top:16px;">
      <h2 class="section-title" style="margin-top:0;">Micronutrient Completion</h2>
      <div class="chart-wrap tall"><canvas id="microChart"></canvas></div>
    </div>

    <div class="grid grid-2" style="margin-top:16px;">
      <div class="card">
        <h2 class="section-title" style="margin-top:0;">Top Deficiencies</h2>
        <div id="deficiency-list"></div>
      </div>
      <div class="card">
        <h2 class="section-title" style="margin-top:0;">Top Excesses</h2>
        <div id="excess-list"></div>
      </div>
    </div>

    <h2 class="section-title">Full Nutrient Breakdown</h2>
    <div class="card">
      <table class="nutrient-table">
        <thead><tr><th>Nutrient</th><th>Consumed</th><th>Target</th><th>%</th></tr></thead>
        <tbody id="nutrient-tbody"></tbody>
      </table>
    </div>
  </section>

  <!-- RECOMMENDATIONS VIEW -->
  <section class="view" id="view-recs">
    <h2 class="section-title">Personalized Recommendations <span class="tag" id="rec-diet-tag">—</span></h2>
    <div id="rec-list"></div>
  </section>

  <!-- RISK ANALYSIS VIEW -->
  <section class="view" id="view-risk">
    <h2 class="section-title">Nutritional Risk Analysis <span class="tag">PATTERN-BASED, NOT DIAGNOSTIC</span></h2>
    <div class="card" style="margin-bottom:18px;font-size:.82rem;color:var(--text-dim);line-height:1.5;">
      These are educational risk flags derived from your logged intake patterns against general reference targets. They are <b style="color:var(--text);">not a medical diagnosis</b>. Persistent deficits or symptoms should be discussed with a healthcare professional and confirmed with lab tests.
    </div>
    <div id="risk-list"></div>
  </section>

  <!-- SOURCES VIEW -->
  <section class="view" id="view-sources">
    <h2 class="section-title">Nutrition Data Sources <span class="tag">TRANSPARENCY</span></h2>
    <div class="card">
      <div class="source-item">
        <div class="src-name">Indian Food Composition Tables (IFCT 2017)</div>
